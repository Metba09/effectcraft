# Copy to .env if you want to set any of these. None is required: with all of them unset the
# build, the core tests and `make verify` run fully offline. Never commit a real .env.

# --- Offline sandbox (read by scripts/sandbox/env.sh; defaults shown) -------------------------
# EFFECTCRAFT_SANDBOX_HOME=$HOME/.effectcraft-sandbox   # toolchain, vendored crates, build output
# EFFECTCRAFT_BUNDLE_DIR=/mnt/user-data/uploads/effectcraft-bundle
# EC_TIMEOUT=270                                         # cap one command so a re-run resumes it
# CARGO_BUILD_JOBS=1

# --- Optional inputs the code looks for; leave unset when you have no local copy --------------
# Local models and fixtures (features and tests that need them skip themselves when unset):
# EFFECTCRAFT_SAM2_DIR=
# EFFECTCRAFT_SAM2=
# EFFECTCRAFT_MOBILESAM=
# EFFECTCRAFT_FACE_LANDMARKER=
# EFFECTCRAFT_AEP_FIXTURES=
# AEP_CORPUS=
# EC_PRESETS_DIR=
# CRAFT_FONTS_DIR=

# GPU: there is none in the sandbox. Do NOT set EFFECTCRAFT_REQUIRE_GPU there.
# EFFECTCRAFT_REQUIRE_GPU=
# WGPU_BACKEND=

# Where UI snapshot tests write images
# EC_SNAPSHOT_DIR=
